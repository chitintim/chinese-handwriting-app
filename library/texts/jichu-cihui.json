  "simp": "基础词语"
 },
 "author": {
  "trad": "編選",
  "simp": "编选"
 },
 "dynasty": {
  "trad": "—",
  "simp": "—"
 },
 "source": "https://zh.wikisource.org/wiki/%E4%BA%8C%E5%8D%81%E5%9B%9B%E7%AF%80%E6%B0%A3",
 "license": "Public domain (traditional word lists)",
 "notes": "數目字、天干、地支、十二生肖、五行方位、四季與二十四節氣的字詞表，為最常見的傳統基礎詞語，供初學者練習；無文本版權問題。",
 "sections": [
  {
   "id": "shuzi",
   "title": {
    "trad": "數目",
    "simp": "数目"
   },
   "body": {
    "trad": "零一二三四，五六七八九，十百千萬億。",
    "simp": "零一二三四，五六七八九，十百千万亿。"
   }
  },
  {
   "id": "tiangan",
   "title": {
    "trad": "天干",
    "simp": "天干"
   },
   "body": {
    "trad": "甲乙丙丁戊，己庚辛壬癸。",
    "simp": "甲乙丙丁戊，己庚辛壬癸。"
   }
  },
  {
   "id": "dizhi",
   "title": {
    "trad": "地支",
    "simp": "地支"
   },
   "body": {
    "trad": "子丑寅卯辰，巳午未申酉，戌亥。",
    "simp": "子丑寅卯辰，巳午未申酉，戌亥。"
   }
  },
  {
   "id": "shengxiao",
   "title": {
    "trad": "十二生肖",
    "simp": "十二生肖"
   },
   "body": {
    "trad": "鼠牛虎兔龍，蛇馬羊猴雞，狗豬。",
    "simp": "鼠牛虎兔龙，蛇马羊猴鸡，狗猪。"
   }
  },
  {
   "id": "wuxing",
   "title": {
    "trad": "五行方位",
    "simp": "五行方位"
   },
   "body": {
    "trad": "金木水火土，東南西北中。",
    "simp": "金木水火土，东南西北中。"
   }
  },
  {
   "id": "siji",
   "title": {
    "trad": "四季",
    "simp": "四季"
   },
   "body": {
    "trad": "春夏秋冬。",
    "simp": "春夏秋冬。"
   }
  },
  {
   "id": "jieqi_chun",
   "title": {
    "trad": "二十四節氣 · 春夏",
    "simp": "二十四节气 · 春夏"
   },
   "body": {
    "trad": "立春雨水，驚蟄春分，清明穀雨，立夏小滿，芒種夏至，小暑大暑。",
    "simp": "立春雨水，惊蛰春分，清明谷雨，立夏小满，芒种夏至，小暑大暑。"
   }
  },
  {
   "id": "jieqi_qiu",
   "title": {
    "trad": "二十四節氣 · 秋冬",
    "simp": "二十四节气 · 秋冬"
   },
   "body": {
    "trad": "立秋處暑，白露秋分，寒露霜降，立冬小雪，大雪冬至，小寒大寒。",
    "simp": "立秋处暑，白露秋分，寒露霜降，立冬小雪，大雪冬至，小寒大寒。"
   }
  }
 ]
}
