 "sections": [
  {
   "id": "heng",
   "title": {
    "trad": "筆畫 · 橫",
    "simp": "笔画 · 横"
   },
   "body": {
    "trad": "一二三十土，王工干下上。",
    "simp": "一二三十土，王工干下上。"
   }
  },
  {
   "id": "shu",
   "title": {
    "trad": "筆畫 · 豎",
    "simp": "笔画 · 竖"
   },
   "body": {
    "trad": "十中上下午，牛平年山川。",
    "simp": "十中上下午，牛平年山川。"
   }
  },
  {
   "id": "pie",
   "title": {
    "trad": "筆畫 · 撇",
    "simp": "笔画 · 撇"
   },
   "body": {
    "trad": "人八大千生，月用代氣禾。",
    "simp": "人八大千生，月用代气禾。"
   }
  },
  {
   "id": "na",
   "title": {
    "trad": "筆畫 · 捺",
    "simp": "笔画 · 捺"
   },
   "body": {
    "trad": "人入八大天，火木走又之。",
    "simp": "人入八大天，火木走又之。"
   }
  },
  {
   "id": "dian",
   "title": {
    "trad": "筆畫 · 點",
    "simp": "笔画 · 点"
   },
   "body": {
    "trad": "主言文心玄，小立六求。",
    "simp": "主言文心玄，小立六求。"
   }
  },
  {
   "id": "ti",
   "title": {
    "trad": "筆畫 · 挑",
    "simp": "笔画 · 挑"
   },
   "body": {
    "trad": "地江打冰河，海法技場孩。",
    "simp": "地江打冰河，海法技场孩。"
   }
  },
  {
   "id": "shugou",
   "title": {
    "trad": "筆畫 · 豎鉤",
    "simp": "笔画 · 竖钩"
   },
   "body": {
    "trad": "小水事求手，才永了丁予。",
    "simp": "小水事求手，才永了丁予。"
   }
  },
  {
   "id": "hengzhe",
   "title": {
    "trad": "筆畫 · 橫折",
    "simp": "笔画 · 横折"
   },
   "body": {
    "trad": "日口目田四，回中冒國。",
    "simp": "日口目田四，回中冒国。"
   }
  },
  {
   "id": "hengzhegou",
   "title": {
    "trad": "筆畫 · 橫折鉤",
    "simp": "笔画 · 横折钩"
   },
   "body": {
    "trad": "月同勿句司，風用別周問。",
    "simp": "月同勿句司，风用别周问。"
   }
  },
  {
   "id": "wangou",
   "title": {
    "trad": "筆畫 · 彎鉤",
    "simp": "笔画 · 弯钩"
   },
   "body": {
    "trad": "狗家孫猫逐，我戈成氏代。",
    "simp": "狗家孙猫逐，我戈成氏代。"
   }
  },
  {
   "id": "xiegou",
   "title": {
    "trad": "筆畫 · 斜鉤",
    "simp": "笔画 · 斜钩"
   },
   "body": {
    "trad": "我戈成或戰，伐武式找戲。",
    "simp": "我戈成或战，伐武式找戏。"
   }
  },
  {
   "id": "piezhe",
   "title": {
    "trad": "筆畫 · 撇折",
    "simp": "笔画 · 撇折"
   },
   "body": {
    "trad": "么公去台能，私允牟弘參。",
    "simp": "么公去台能，私允牟弘参。"
   }
  }
 ]
